<h1>商品一覧</h1>

<p><%= link_to "商品を登録する", new_product_path %></p>

<table border="1" cellpadding="5">
  <tr>
    <th>商品名</th>
    <th>価格</th>
    <th>操作</th>
  </tr>
  <% @products.each do |p| %>
    <tr>
      <td><%= p.names %></td>
      <td><%= p.price %>円</td>
      <td>
        <%= button_to "カートに追加", cartitems_path(product_id: p.id), method: :post %>
        <%= link_to "削除", product_path(p), data: { turbo_method: :delete, confirm: "削除しますか？" } %>
      </td>
    </tr>
  <% end %>
</table>

<p><%= link_to "カートを見る", carts_path %></p>
